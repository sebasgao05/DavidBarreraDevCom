{
  "name": "david-barrera-portafolio",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "framer-motion": "^12.42.0",
    "i18next": "^23.7.0",
    "lucide-react": "^1.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^13.5.0",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "autoprefixer": "^10.5.2",
    "aws-sdk": "^2.1693.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^8.57.0",
    "lighthouse": "^13.1.0",
    "mime-types": "^3.0.2",
    "postcss": "^8.5.16",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.3.0",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/clean-preloads.js",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --coverage --watchAll=false --passWithNoTests",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings=0",
    "build:prod": "node scripts/optimize-images.js && npm run build && node scripts/optimize-performance-enhanced.js && node scripts/clean-preloads.js",
    "validate": "node scripts/build-and-validate.js",
    "deploy": "npm run validate && npm run build:prod && node scripts/deploy.js",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "setup:assets": "node scripts/setup-assets.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:performance": "node scripts/optimize-performance-enhanced.js",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:favicon": "node scripts/generate-favicon.js",
    "generate:responsive": "node scripts/generate-responsive-images.js",
    "generate:responsive:enhanced": "node scripts/generate-responsive-images-enhanced.js",
    "deploy:optimized": "npm run validate && npm run build:prod && node scripts/deploy-optimized.js",
    "generate:screenshots": "node scripts/generate-screenshots.js",
    "seo:check": "lighthouse https://david-barrera.com --output=html --output-path=./lighthouse-report.html",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "perf:audit": "lighthouse http://localhost:3000 --output=html --output-path=./performance-audit.html --chrome-flags='--headless'",
    "perf:monitor": "node -e \"console.log('Performance monitoring enabled in production build')\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "pnpm": {
    "overrides": {
      "nth-check": ">=2.0.1",
      "postcss": ">=8.5.16",
      "serialize-javascript": ">=7.0.5",
      "underscore": ">=1.13.8",
      "webpack-dev-server": ">=5.2.4",
      "uuid": ">=11.1.1",
      "js-yaml": ">=4.2.0",
      "@opentelemetry/core": ">=2.8.0",
      "@tootallnate/once": ">=2.0.1"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
